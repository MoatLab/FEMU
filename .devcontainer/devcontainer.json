{
  "name": "FEMU",
  "build": {
    "dockerfile": "../hw/femu/container/Containerfile",
    "context": "..",
    "target": "deps"
  },
  "remoteUser": "ubuntu",
  "updateRemoteUserUID": true,
  "postCreateCommand": "git config --global --add safe.directory ${containerWorkspaceFolder}",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cpptools",
        "mesonbuild.mesonbuild"
      ]
    }
  }
}
