# See docs/devel/tracing.rst for the syntax documentation.

# nvme-io.c
femu_io_cmd(uint16_t cid, uint32_t nsid, uint8_t opcode) "cid %"PRIu16" nsid %"PRIu32" opc 0x%"PRIx8
femu_cqe(uint16_t cqid, uint16_t cid, uint16_t status, int64_t model_ns) "cq %"PRIu16" cid %"PRIu16" status 0x%"PRIx16" model %"PRId64" ns"

# nvme-admin.c
femu_admin_cmd(uint16_t cid, uint8_t opcode) "cid %"PRIu16" opc 0x%"PRIx8
femu_aer_enqueue(uint8_t type, uint8_t info, uint8_t log_page, uint32_t nsid) "type %"PRIu8" info 0x%"PRIx8" log 0x%"PRIx8" nsid %"PRIu32
femu_sanitize(uint32_t cdw10, bool done) "cdw10 0x%"PRIx32" done %d"

# femu-power.c
femu_power_state(uint8_t from, uint8_t to) "PS%"PRIu8" -> PS%"PRIu8

# bbssd/ftl-line-gc.c
femu_gc_victim(int line, int vpc, int ipc) "line %d vpc %d ipc %d"
femu_erase(int ch, int lun, int pl, int blk, uint32_t erase_cnt) "ch %d lun %d pl %d blk %d erases %"PRIu32
