# Linux options for the FEMU guest boot test, merged into tinyconfig.
# build-guest-kernel.sh requires each one to read "=y" after olddefconfig.
CONFIG_64BIT=y
CONFIG_SMP=y
CONFIG_X86_MPPARSE=y
CONFIG_PRINTK=y
CONFIG_TTY=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_PROC_FS=y
CONFIG_PROC_SYSCTL=y
CONFIG_SYSFS=y
CONFIG_PCI=y
CONFIG_PCI_MSI=y
CONFIG_BLOCK=y
CONFIG_BLK_DEV_ZONED=y
CONFIG_BLK_DEV_NVME=y
CONFIG_FUTEX=y
